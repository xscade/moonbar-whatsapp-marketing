# Local development environment for Moonbar WhatsApp Marketing.
# Copy to .env.local (the install script does this automatically) and fill in
# real WhatsApp Cloud API credentials when exercising live message sends.

# MongoDB connection string. Defaults to the local MongoDB instance started by
# the Cloud Agent start script. The database name is taken from the path.
MONGODB_URI=mongodb://127.0.0.1:27017/moonbar

# WhatsApp Cloud API credentials. The placeholders below let the app boot and
# serve the setup/login/dashboard/contacts/lists flows against MongoDB.
# Real values are only required for live template sync and campaign sends.
WHATSAPP_ACCESS_TOKEN=local-dev-placeholder-token
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=000000000000000
WHATSAPP_APP_ID=000000000000000
WHATSAPP_APP_SECRET=local-dev-placeholder-secret
WHATSAPP_VERIFY_TOKEN=moonbar_verify_token
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
